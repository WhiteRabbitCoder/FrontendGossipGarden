# Preferred in Railway:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Fallback if you don't use DATABASE_URL:
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=yourpassword
# POSTGRES_DB=plants_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
DATABASE_URL=

# ------------------------------
# MQTT (optional, has hardcoded fallback)
# ------------------------------
